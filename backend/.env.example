# Smart Maintenance Request & Escalation System (SMRES) Environment Configuration

# Database connection URL (PostgreSQL with psycopg3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5433/smres

# SLA Mode: 'demo' (minutes: 1m/2m/5m/10m) or 'prod' (hours: 1h/4h/24h/48h)
SLA_MODE=demo

# Server Port and Host
HOST=127.0.0.1
PORT=8000
