# Smart Maintenance Request & Escalation System (SMRES) Root Configuration

# Backend PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5433/smres

# SLA Mode: 'demo' (1m, 2m, 5m, 10m) or 'prod' (1h, 4h, 24h, 48h)
SLA_MODE=demo

# Frontend API base URL (defaults to Vite proxy /api)
VITE_API_URL=http://localhost:8000
